# ---------------------------------------------------------------------------
# Local development secrets template.
#
# Copy this file to ".env" and replace every placeholder with a real value.
# ".env" is git-ignored and must never be committed.
#
#   Copy-Item .env.example .env
#
# For "dotnet run" (without Docker) the same values are supplied through
# user secrets instead:  dotnet user-secrets set "<Key>" "<Value>" --project .\AppointMan.Api\AppointMan.Api.csproj
# ---------------------------------------------------------------------------

# SQL Server SA password used by docker-compose.yml
SA_PASSWORD=__REPLACE_WITH_A_STRONG_PASSWORD__

# JWT symmetric signing key (at least 32 bytes of UTF-8 data).
# Generate one with:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=__REPLACE_WITH_A_RANDOM_64_CHAR_SECRET__

# Graylog GELF/UDP loglama. false ise provider hic kaydedilmez (no-op).
GRAYLOG_ENABLED=false
GRAYLOG_HOST=localhost
GRAYLOG_PORT=12201
# Ek maskelenecek alanlar, virgul ile ayrilmis (varsayilan liste zaten uygulanir).
GRAYLOG_MASKED_FIELDS=

# Grafana admin parolasi (docker-compose.yml icindeki grafana servisi kullanir).
GRAFANA_ADMIN_PASSWORD=__REPLACE_WITH_A_STRONG_PASSWORD__
