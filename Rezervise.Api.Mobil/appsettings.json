{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    // Issuer must be an absolute URI: JwtSettings validation fails fast at startup otherwise.
    "Issuer": "https://Rezervise.local",
    "Audience": "Rezervise-Users",
    "ExpirationInMinutes": 60,
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7,
    "ClockSkewSeconds": 0,
    "RequireHttpsMetadata": true
  },
  "Business": {
    // Opening hours are stored as local wall-clock time; API timestamps arrive in UTC.
    "TimeZoneOffsetHours": 3
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=()"
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576,
      "MaxRequestHeadersTotalSize": 32768,
      "MaxRequestLineSize": 8192
    }
  },
  "Graylog": {
    "Enabled": true,
    "Host": "104.247.163.45",
    "Port": 12201,
    "Source": "Rezervise.Api",
    "MaxMessageBytes": 60000,
    "QueueCapacity": 5000,
    "MaskedFields": []
  },
  "Metrics": {
    "Enabled": true,
    "EndpointPath": "/metrics",
    "ServiceName": "Rezervise.Api",
    "IncludeEfCoreInstrumentation": true
  },
  "Email": {
    // Host bos ise uygulama otomatik olarak log moduna duser (Development icin standart).
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@rezervise.com",
    "FromName": "Rezervise",
    // Dogrulama e-postasindaki bagin temel adresi. Token bu adrese ?token=... olarak eklenir.
    "VerificationLinkBaseUrl": "http://localhost:8080/api/Auth/verify-email",
    "TokenLifetimeHours": 24,
    // Yeniden gonderim bekleme suresi (dakika). Istek bundan once gelirse e-posta gonderilmez.
    "ResendCooldownMinutes": 3,
    "QueueCapacity": 500,
    "SmtpTimeoutMilliseconds": 15000
  },
  "Otp": {
    // SMS saglayici baglanana kadar sabit kod kullanilir. Uretimde bos birakilmalidir.
    "FixedCode": "123456",
    "CodeLength": 6,
    "LifetimeMinutes": 5,
    "MaxAttempts": 5,
    // Yeniden kod isteme bekleme suresi (saniye): 180 = 3 dakika.
    "ResendCooldownSeconds": 180
  },
  "Push": {
    // FCM push bildirimleri. Gercek gonderim icin Enabled=true ve asagidaki iki
    // alan dolmalidir; aksi halde bildirimler yalnizca log'a yazilir (log modu).
    // ServiceAccountPath: Firebase Console > Project settings > Service accounts
    // > "Generate new private key" ile indirilen JSON'un SUNUCUDAKI yolu.
    // Dosya repoya ASLA commit edilmez.
    "Enabled": false,
    "ProjectId": "",
    "ServiceAccountPath": "",
    "QueueCapacity": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
