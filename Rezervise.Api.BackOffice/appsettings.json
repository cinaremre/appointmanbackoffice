{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    // Backoffice ayri audience kullanir: musteri API token'lari gecersizdir.
    "Issuer": "https://Rezervise.local",
    "Audience": "Rezervise-Backoffice",
    "ClockSkewSeconds": 0,
    "RequireHttpsMetadata": true
  },
  "BackOfficePagination": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200
  },
  "Cors": {
    // Backoffice React uygulamasinin origin listesi. Production'da bos birakilir.
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
